# Production configuration. Set these values in your host's environment before deployment.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
# Keep disabled in production; use object storage or the web server for uploaded media.
DJANGO_SERVE_MEDIA=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Only enable when your trusted reverse proxy overwrites this header:
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# PostgreSQL. Keep DJANGO_DB_ENGINE=sqlite for local SQLite development.
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=require
DJANGO_DB_CONN_MAX_AGE=60
